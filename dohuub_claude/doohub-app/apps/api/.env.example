# =============================================================================
# DoHuub API — environment template
# Copy to .env (NEVER commit .env). In production, set these in Railway.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# ---- Database (Supabase Postgres via Prisma) --------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ---- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://qiotpmjbhjpegylqgrwd.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- JWT (legacy dev-login endpoints only; real auth uses Supabase) --------
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ---- CORS (comma-separated, no trailing slash) ------------------------------
# REQUIRED in production. Example:
#   ALLOWED_ORIGINS=https://portal.dohuub.com,https://admin.dohuub.com
ALLOWED_ORIGINS=

# ---- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Where Stripe Checkout should redirect on success/cancel.
STRIPE_RETURN_URL=dohuub://checkout/return

# ---- Email (OTP + transactional) -------------------------------------------
# PREFERRED on Railway / any PaaS: Resend HTTP API (no blocked ports).
# Grab a key from https://resend.com → API Keys.
RESEND_API_KEY=

# SMTP fallback (used if RESEND_API_KEY is empty OR the HTTP send fails).
# WARNING: Railway blocks outbound SMTP on 25/465/587. SMTP only works on
# hosts that allow it (your laptop, AWS EC2, dedicated servers, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DoHuub <onboarding@resend.dev>

# ---- Chat agent (mcp-intelligence-agent) ------------------------------------
AGENT_BASE_URL=http://localhost:8000
AGENT_SERVICE_USER=dohuub_service
AGENT_SERVICE_PASSWORD=

# ---- Sentry (optional but recommended) --------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=

# ---- Uploads ----------------------------------------------------------------
# Uploads go to Supabase Storage (see routes/upload.ts). No env var needed
# beyond SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above. Buckets required:
#   - listings   (vendor service/store images, publicly readable)
#   - uploads    (general user uploads, publicly readable)
