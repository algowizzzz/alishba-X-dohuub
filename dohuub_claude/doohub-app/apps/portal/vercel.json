{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm install --include=optional --legacy-peer-deps --force",
  "rewrites": [
    { "source": "/", "destination": "/landing/index.html" },
    { "source": "/((?!landing/).*)", "destination": "/index.html" }
  ]
}
